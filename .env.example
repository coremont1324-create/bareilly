# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# PostgreSQL connection string (never commit real credentials)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/mandal_portal
# Set to true for managed Postgres that requires TLS (Render, Railway, Neon, RDS …)
DATABASE_SSL=false
# Public URL of the site, used for canonical links, sitemap and CSRF origin checks
PUBLIC_BASE_URL=http://localhost:5173
# Extra origins allowed to make state-changing requests (comma separated, optional)
ALLOWED_ORIGINS=
# Admin session lifetime in hours
SESSION_TTL_HOURS=8
# Cookies are Secure by default in production; override only for local HTTP testing
# COOKIE_SECURE=false
# Trust the first reverse proxy (needed on Render/Railway/Heroku for correct client IPs)
# TRUST_PROXY=true
# Run pending migrations automatically when the server starts (default true)
AUTO_MIGRATE=true
# Max failed sign-in attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# --- First administrator (used once by `npm run db:seed` when no admin exists) ---
# Remove these from the environment after the first deploy.
ADMIN_EMAIL=
ADMIN_NAME=Portal Administrator
ADMIN_PASSWORD=

# --- Tests ------------------------------------------------------------------
# A separate, disposable database. It is wiped by the test suite.
DATABASE_URL_TEST=postgres://USER:PASSWORD@localhost:5432/mandal_portal_test
